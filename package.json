{
  "name": "issueflow",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @issueflow/api --filter @issueflow/web dev",
    "dev:api": "pnpm --filter @issueflow/api dev",
    "dev:web": "pnpm --filter @issueflow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @issueflow/api db:generate",
    "db:migrate": "pnpm --filter @issueflow/api db:migrate",
    "db:seed": "pnpm --filter @issueflow/api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
