# Copy this file to .env.docker, then run:
# `docker compose --env-file .env.docker up -d --build`
# The only host port exposed by default is the web entrypoint.
WEB_PORT=18080
ISSUEFLOW_WEB_ORIGIN=http://localhost:18080

# Number of trusted reverse-proxy hops before the API. Compose Nginx alone is 1;
# an external TLS proxy in front of Compose Nginx makes this 2.
ISSUEFLOW_TRUST_PROXY_HOPS=1

# Used only when the database has no administrator yet.
ISSUEFLOW_ADMIN_USERNAME=admin
ISSUEFLOW_ADMIN_PASSWORD=replace-with-a-strong-password
ISSUEFLOW_ADMIN_DISPLAY_NAME=IssueFlow Administrator

# Login sessions are stored in the persistent SQLite database.
ISSUEFLOW_SESSION_TTL_DAYS=30

# Keep false for local HTTP. Set true only when users access IssueFlow over HTTPS.
ISSUEFLOW_COOKIE_SECURE=false

# Required for public account registration. Leave empty to disable registration.
ISSUEFLOW_REGISTRATION_INVITE_CODE=replace-with-a-private-invitation-code

# Required before saving Yunxiao credentials, an AI API Key, S3 credentials, or WebDAV credentials. Generate with: openssl rand -hex 32
ISSUEFLOW_YUNXIAO_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Public browser origin Yunxiao can call. Do not append /api.
ISSUEFLOW_YUNXIAO_WEBHOOK_BASE_URL=https://issues.example.com
