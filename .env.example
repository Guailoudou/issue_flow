DATABASE_URL="file:./issueflow.db"
API_PORT=3101
WEB_ORIGIN="http://localhost:5173"
SESSION_TTL_DAYS=30
# 本地 HTTP 使用 false；生产 HTTPS 必须设置为 true。
COOKIE_SECURE=false
# 公开注册所需的邀请码；留空时禁用注册。
REGISTRATION_INVITE_CODE=""
UPLOAD_DIR="./uploads"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-now"
ADMIN_DISPLAY_NAME="Platform Admin"
# 使用 `openssl rand -hex 32` 生成；配置云效凭据或 AI API Key 前必须设置。
YUNXIAO_ENCRYPTION_KEY=""
# 云效可访问的 IssueFlow 公网地址，不要包含末尾斜杠。
YUNXIAO_WEBHOOK_BASE_URL="http://localhost:3101"
