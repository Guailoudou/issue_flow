{
  "name": "@issueflow/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=file:./test.db prisma generate && DATABASE_URL=file:./test.db prisma db push && DATABASE_URL=file:./test.db vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@issueflow/shared": "workspace:*",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
